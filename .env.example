PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TZ=Asia/Dhaka
MONGODB_URI=

# Legacy custom JWT auth. Keep only until the Better Auth migration is approved and tested.
JWT_SECRET=

# Better Auth (Phase 2). BETTER_AUTH_SECRET must be at least 32 characters.
# BETTER_AUTH_URL is the public API origin (no /api path).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth. The existing custom callback is transitional; Better Auth uses /api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Stripe (Phase 5). STRIPE_WEBHOOK_SECRET is created in Stripe Dashboard after the webhook endpoint exists.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/payment/cancel

# ImgBB (Phase 4). Server-side only; never expose this key to the frontend.
IMGBB_API_KEY=
