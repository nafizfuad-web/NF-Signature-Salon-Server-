PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TZ=Asia/Dhaka
MONGODB_URI=

# Legacy custom JWT auth. Keep only until the Better Auth migration is approved and tested.
JWT_SECRET=

# Better Auth (Phase 2). BETTER_AUTH_SECRET must be at least 32 characters.
# BETTER_AUTH_URL is the public API origin (no /api path).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth. The existing custom callback is transitional; Better Auth uses /api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Stripe (Phase 5). STRIPE_WEBHOOK_SECRET is created in Stripe Dashboard after the webhook endpoint exists.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/payment/cancel

# TEST payment simulator only. Never enables real Stripe/bKash/Nagad or production payments.
PAYMENT_ENV=TEST
PAYMENT_SIMULATOR_ENABLED=false
PAYMENT_TEST_DEMO_AMOUNT_BDT=500

# bKash sandbox Checkout (mode 0011). Use sandbox credentials only; never commit real secrets.
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:5000/api/payments/bkash/callback

# Nagad sandbox requires merchant-issued keys/IP whitelisting. Leave blank until approved.
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_ACCOUNT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_GATEWAY_PUBLIC_KEY=
NAGAD_SERVER_IP=
NAGAD_CALLBACK_URL=http://localhost:5000/api/payments/nagad/callback
NAGAD_SIGNATURE_ALGORITHM=SHA256

# ImgBB (Phase 4). Server-side only; never expose this key to the frontend.
IMGBB_API_KEY=
